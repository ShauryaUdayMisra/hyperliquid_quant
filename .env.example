# Copy to .env and edit. .env is gitignored; never commit real secrets.

# --- Safety ---------------------------------------------------------------
# This system is PAPER TRADING ONLY. It refuses to start if any of
# HL_PRIVATE_KEY / HYPERLIQUID_PRIVATE_KEY / PRIVATE_KEY / SECRET_KEY /
# WALLET_PRIVATE_KEY / HL_API_SECRET is set. Do not add them.

# --- Risk profile ---------------------------------------------------------
# "aggressive"   10x leverage, 100% risk/trade, no daily-loss or drawdown halt
# "conservative"  2x leverage, 0.25% risk/trade, 2% daily loss, 10% max DD
RISK_PROFILE=aggressive
# Individual overrides (optional; they win over the profile):
# STARTING_CAPITAL=100000
# MAX_POSITION_USD=100000
# MAX_LEVERAGE=10
# RISK_PER_TRADE=1.0
# MAX_DAILY_LOSS=1.0
# MAX_PORTFOLIO_DD=1.0
# MAX_OPEN_POSITIONS=3

# --- Market data ----------------------------------------------------------
MARKETS=BTC,ETH,SOL
CANDLE_INTERVALS=1m,5m,1h
BACKFILL_DAYS=180
ORDERBOOK_SNAPSHOT_INTERVAL_S=10
ORDERBOOK_DEPTH=20
ASSET_CTX_INTERVAL_S=60
FLUSH_INTERVAL_S=60

# --- Hyperliquid API (public, read-only) ----------------------------------
HL_INFO_URL=https://api.hyperliquid.xyz/info
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_RATE_LIMIT_PER_MINUTE=600
# Only needed if a corporate firewall SSL-inspects your traffic. See README.
# HL_CA_BUNDLE=/absolute/path/to/ca-bundle.pem

# --- Execution realism ----------------------------------------------------
TAKER_FEE=0.00045
MAKER_FEE=0.00015
DEFAULT_HALF_SPREAD=0.00005
IMPACT_COEFFICIENT=0.10
LATENCY_MS=250
MAX_BAR_VOLUME_SHARE=0.10
LIQUIDATION_PENALTY=0.01

# --- Email reports (Phase 7) ----------------------------------------------
REPORT_ENABLED=false
# Where the 6-hour reports are delivered. Required for email to work.
REPORT_RECIPIENT=
REPORT_SENDER=your.address@gmail.com
REPORT_HOURS=0,6,12,18
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
# Gmail app password (needs 2FA enabled), NOT your account password.
SMTP_APP_PASSWORD=

LOG_LEVEL=INFO
